<div class="title_top"> Address Book </div>
<table>
<% for address in @addresses %>
<tr>
  <td class='tltle'><%=h address[:title] %></td>
  <td class='tel'><%=h address[:tel] %></td>
  <td class='edit'><%= link_to '編集(Edit)', :action => 'edit', :id => address[:id] %></td>
  <td class='edit'><%= link_to '削除(Delete)', :action => 'confirm_delete', :id => address[:id] %></td>
  
</tr>
<% end %>
</table>
